to_dict(self) -> dict:\n        \"\"\"Get current fields as dictionary.\"\"\"\n        result = {}\n        for k, v in asdict(self).items():\n            if v is not None:\n                # Extract value from Text wrapper\n                result[k] = v.value if isinstance(v, Text) else v\n        return result\n\n    def clear(self):\n        \"\"\"Reset all fields to None.\"\"\"\n        self.status = None\n        self.progress = None\n        self.current_item = None\n        self.items_processed = None\n        self.last_processed_id = None\n```\n\n## Usage in Actions\n\n### Basic Progress Tracking\n\n```python\nfrom fields.output import OutputFields\n\ndef process_items_action(input_data: InputFields):\n    # Create output tracker\n    output_fields = OutputFields()\n\n    # Update UI in real-time during processing\n    for i, item in enumerate(items):\n        output_fields.update(\n            status=\"Processing\",\n            progress=f\"{i+1}/{len(items)}\",\n            current_item=item.name,\n            items_processed=i+1\n        )\n        process(item)\n\n    # Final update\n    output_fields.update(\n        status=\"Complete\",\n        progress=\"100%\"\n    )\n    ...\n```\n\n### Re-run Support (Resume from Previous Run)\n\nThis is only in the case we want to have RE-RUN logic. \n\n*Not common in most extensions*\n\nWhen extension is re-run, previous OutputFields are automatically available as a part of the InputFields:\n\n```python\ndef incremental_sync_action(input_data: InputFields):\n    output_fields = OutputFields()\n\n    # Check if re-run\n    if input_data.previous_output:\n        # Run with some re-run logic\n    else:\n        # First run logic\n\n    # Process items\n    for item in items:\n        process(item)\n        output_fields.update(\n            last_processed_id=item.id,\n            items_processed=output_fields.items_processed + 1\n        )\n    ...\n```\n\n## Field Customization\n\nDefine fields based on your extension's needs using Text wrapper:\n\n```python\nfrom fields.types import Text\n\n@dataclass\nclass OutputFields:\n    # Progress tracking\n    status: Optional[Text] = None\n    progress: Optional[Text] = None\n\n    # Current item tracking\n    current_item: Optional[Text] = None\n    current_phase: Optional[Text] = None\n\n    # Counters (wrapped in Text for UI display)\n    items_processed: Optional[Text] = None\n    errors_count: Optional[Text] = None\n    warnings_count: Optional[Text] = None\n\n    # Resume support\n    last_processed_id: Optional[Text] = None\n\n    # Custom fields\n```\n\nUpdate `clear()` method to match your fields:\n\n```python\ndef clear(self):\n    \"\"\"Reset all fields.\"\"\"\n    self.status = None\n    self.progress = None\n    self.current_item = None\n    # ... reset all your custom fields\n```\n\n## UI Sync Behavior\n\n**`update(**fields)`** calls `ui.update_output_fields(fields)` which:\n- Sends updates to UAC UI immediately\n- Updates extension task output fields in real-time\n- Allows users to see progress without waiting for completion\n\n**Use for:**\n- Long-running operations (loops, API calls, file processing)\n- Progress percentage tracking\n- Current item/phase display\n- Real-time counters\n\n## Automatic Previous Run Detection\n\nWhen a task is re-run, UAC includes previous OutputFields as flat fields in the incoming fields dict.\n\n`preprocess_fields()` in InputFields automatically:\n1. Identifies which fields belong to OutputFields (checks field names against OutputFields dataclass)\n2. Extracts those fields from the main fields dict\n3. Creates OutputFields instance from extracted fields\n4. Populates `input_data.previous_output` with the OutputFields instance\n\n**Example:**\n```python\n# UAC sends re-run with previous output fields mixed in\nfields = {\n    \"action\": \"sync\",\n    \"resource_name\": \"my-resource\",\n    \"status\": \"Processing\",           # OutputFields from previous run\n    \"progress\": \"